{
  "name": "bankjobs-sa",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "ingest": "pnpm --filter @bankjobs/ingest run ingest",
    "test": "vitest run && pnpm --filter @bankjobs/api run test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --filter @bankjobs/site run dev",
    "build": "pnpm --filter @bankjobs/site run build",
    "preview": "pnpm --filter @bankjobs/site run preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
