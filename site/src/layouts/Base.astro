---
import '../styles/global.css';
import { meta } from '../lib/data';
import { formatUpdatedAbsolute } from '../lib/freshness';
import { ALL_FEED } from '../lib/feeds';
import type { FeedLink } from '../lib/feeds';

interface Props {
  title: string;
  description: string;
  /** Constrain <main> to the narrow measure (detail / about pages). */
  narrow?: boolean;
  /** Full-bleed main: the page manages its own .wrap per section (homepage). */
  bleed?: boolean;
  /**
   * A second, page-specific feed to advertise alongside the site-wide one —
   * the bank and category ledgers pass their own. Build it with bankFeed() /
   * categoryFeed() so the title matches the feed's own channel title.
   */
  feed?: FeedLink;
}

const { title, description, narrow = false, bleed = false, feed } = Astro.props;
const wrapClass = narrow ? 'wrap wrap--narrow' : 'wrap';

// ONE absolute URL per page, shared by <link rel="canonical"> and og:url — a
// preview that advertises a different URL than the canonical one splits the
// page's identity across crawlers and share cards.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// One static brand card for the whole site (site/public/og.png, 1200x630).
// MUST be absolute: WhatsApp/Facebook silently drop relative og:image paths.
const ogImage = new URL('/og.png', Astro.site).href;

// Job detail pages append " | mybankjobs" to their <title>; og:site_name
// already carries the brand, so the suffix would say it twice in a preview.
// Every other page uses the " — mybankjobs" em-dash form, which reads as part
// of the sentence and stays.
const BRAND_SUFFIX = ' | mybankjobs';
const ogTitle = title.endsWith(BRAND_SUFFIX) ? title.slice(0, -BRAND_SUFFIX.length) : title;
{/* The build bakes the ABSOLUTE form ('23 Jul, 19:58') — a static page is
    served long after it is built, so 'today'/'yesterday' can only be decided
    in the browser. The script below upgrades the wording at view time;
    without JS the absolute form stays, which is never wrong. */}
const updated = formatUpdatedAbsolute(meta.generatedAt);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {/* The site also answers on bankjobs-sa.pages.dev (Pages keeps that origin
        alive) — an absolute canonical on every page keeps search engines on
        the real domain. */}
    <link rel="canonical" href={canonicalUrl} />
    {/* Rich link previews. WhatsApp is the share channel this site is built
        for (see the share block on job pages) and it reads the og:* tags;
        the twitter:* set is the fallback other apps look for. No fb:app_id,
        no analytics-adjacent tags. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mybankjobs" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="mybankjobs — every official bank vacancy in South Africa. One page."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Feed autodiscovery. The site-wide feed is on EVERY page — a reader that
        lands anywhere can subscribe — and pages with a narrower feed of their
        own (a bank, a category) list that one second. */}
    <link rel="alternate" type="application/rss+xml" title={ALL_FEED.title} href={ALL_FEED.href} />
    {
      feed && (
        <link rel="alternate" type="application/rss+xml" title={feed.title} href={feed.href} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/">my<em>bank</em>jobs</a>
        {/* Phones show only the timestamp — .fr-count (the vacancy count) is
            hidden by the mobile block in global.css. */}
        <p class="freshness">
          Last updated <strong id="fr-updated" data-generated-at={meta.generatedAt}>{updated}</strong><span class="fr-count">
            · <strong>{meta.totalSA}</strong> open vacancies</span>
        </p>
      </div>
    </header>

    <main id="main" class:list={['site-main', { bleed }]}>
      {bleed ? <slot /> : <div class={wrapClass}><slot /></div>}
    </main>

    {/* The unaffiliated disclaimer + takedown contact live on /about — the
        footer keeps a link there so they stay one click away on every page. */}
    <script>
      // The two passes a static page cannot bake, on every page: the header's
      // relative freshness wording, and the "new since your last visit" flags.
      // Bundled by Astro into an external same-origin file (assetsInlineLimit:
      // 0), which script-src 'self' already allows.
      //
      // Every import here is dependency-free by design — none of them reaches
      // lib/data.ts, so the gitignored job snapshot never lands in this bundle.
      import { formatUpdatedLabel } from '../lib/freshness';
      import { getLocalStorage, loadSaved } from '../lib/savedJobs';
      import { isNewSince, recordVisit } from '../lib/visit';

      // Re-render the header freshness label relative to NOW ('today 19:58',
      // 'last night 19:58', 'yesterday 15:00'), replacing the baked absolute
      // fallback.
      const el = document.getElementById('fr-updated');
      const generatedAt = el?.dataset.generatedAt;
      if (el && generatedAt) el.textContent = formatUpdatedLabel(generatedAt);

      // One storage handle, shared below: visit bookkeeping and the footer's
      // saved-link check both read the same localStorage.
      const storage = getLocalStorage();

      // Visit bookkeeping is SITE-WIDE: any page view is browsing activity, so
      // the session clock cannot depend on which page was landed on. Rows that
      // first appeared after the previous session get their flag unhidden;
      // with no previous session (a first-ever visit, or storage we cannot
      // write to) nothing is flagged at all.
      const visit = recordVisit(storage);
      if (visit.prev) {
        for (const row of document.querySelectorAll<HTMLElement>('[data-first-seen]')) {
          if (isNewSince(row.dataset.firstSeen ?? null, visit.prev)) {
            row.querySelector('.new-flag')?.removeAttribute('hidden');
          }
        }
      }

      // The footer's "saved" link is only useful to a visitor who actually has
      // a shortlist — reveal it once loadSaved (this same storage handle)
      // proves the list is non-empty. No-JS or unwritable-storage visitors
      // never see it, which is honest: the localStorage shortlist is unusable
      // for them anyway.
      if (loadSaved(storage).length > 0) {
        document.querySelector('.ft-saved')?.removeAttribute('hidden');
      }
    </script>

    <footer class="site-footer">
      <div class="wrap">
        {/* The saved link ships hidden and is revealed by the script above only
            for a visitor whose shortlist is non-empty — on EVERY viewport, not
            just mobile, so there is one rule rather than a media-query special
            case. The separator dot lives inside .ft-saved too, so a hidden
            link leaves no dangling " · ". No-JS or unwritable-storage visitors
            never see it, which is honest: the localStorage shortlist is
            unusable for them anyway. */}
        <p>Made with ❤️ by Tebello<span class="ft-saved" hidden> · <a href="/saved/">saved</a></span><span class="ft-extra"> · &copy; {year} mybankjobs · <a href="/fit/">fit</a> · <a href="/insights/">insights</a> · <a href="/about/">about</a> · <a href="/privacy/">privacy</a></span></p>
      </div>
    </footer>
  </body>
</html>
