---
import '../styles/global.css';
import { meta, formatUpdated } from '../lib/data';

interface Props {
  title: string;
  description: string;
  /** Constrain <main> to the narrow measure (detail / about pages). */
  narrow?: boolean;
  /** Full-bleed main: the page manages its own .wrap per section (homepage). */
  bleed?: boolean;
}

const { title, description, narrow = false, bleed = false } = Astro.props;
const wrapClass = narrow ? 'wrap wrap--narrow' : 'wrap';
const updated = formatUpdated(meta.generatedAt);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/">BankJobs<span>&nbsp;SA</span></a>
        <p class="freshness">
          Last updated <strong>{updated}</strong> · <strong>{meta.totalSA}</strong> open vacancies
        </p>
      </div>
    </header>

    <main id="main" class:list={['site-main', { bleed }]}>
      {bleed ? <slot /> : <div class={wrapClass}><slot /></div>}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>BankJobs SA</strong> is an independent, free service and is not affiliated with,
          endorsed by, or acting on behalf of any bank. Bank names are used only to identify whose
          public vacancies are listed. All applications happen on the banks' own official websites.
        </p>
        <p>
          Something wrong, or listing your organisation's jobs and want them removed?
          <a href="mailto:hello@example.co.za">hello@example.co.za</a> — requests are honoured
          promptly.<br /><br />
          <span class="mono small"
            >Light on data by design · works on any phone · &copy; {year} BankJobs SA</span
          >
        </p>
      </div>
    </footer>
  </body>
</html>
