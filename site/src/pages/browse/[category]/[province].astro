---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import JobRow from '../../../components/JobRow.astro';
import { CATEGORY_SLUGS, PROVINCES } from '@bankjobs/core';
import type { Category, Province } from '@bankjobs/core';
import { saJobs } from '../../../lib/data';
import { PROVINCE_SLUGS } from '../../../lib/provinces';

// One page per (category, province) pair that has at least one open SA job.
// Empty pairs are never generated. As with the province pages, the named
// [province] param never collides with the sibling [...page].astro's numeric
// URLs (/browse/software-it/2), so both build side by side.
export const getStaticPaths = (() => {
  const cats = Object.entries(CATEGORY_SLUGS) as Array<[Category, string]>;
  const paths: Array<{
    params: { category: string; province: string };
    props: { name: Category; slug: string; province: Province };
  }> = [];
  for (const [cname, cslug] of cats) {
    for (const pname of PROVINCES) {
      const hasJobs = saJobs().some(
        (j) => j.categorySlug === cslug && j.locations[0]?.province === pname,
      );
      if (!hasJobs) continue;
      paths.push({
        params: { category: cslug, province: PROVINCE_SLUGS[pname] },
        props: { name: cname, slug: cslug, province: pname },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  name: Category;
  slug: string;
  province: Province;
}

const { name, slug, province } = Astro.props;
const provSlug = PROVINCE_SLUGS[province];

// The combo ledger, newest first (saJobs() is already postedDate desc).
const jobs = saJobs().filter(
  (j) => j.categorySlug === slug && j.locations[0]?.province === province,
);
const total = jobs.length;
const noun = total === 1 ? 'role' : 'roles';

// Name the banks hiring here — distinct brands are what job seekers recognise
// (FNB / RMB rather than "FirstRand"), ordered by how many roles each has.
const brandCounts = new Map<string, number>();
for (const j of jobs) brandCounts.set(j.brand, (brandCounts.get(j.brand) ?? 0) + 1);
const brands = [...brandCounts.entries()].sort((a, b) => b[1] - a[1]).map(([b]) => b);
const bankPhrase = naturalList(brands, 4);

/** 'Absa' · 'Absa and Nedbank' · 'Absa, Nedbank and Capitec'; overflow past
    `max` collapses to '… and N more banks'. */
function naturalList(items: string[], max: number): string {
  if (items.length === 0) return '';
  if (items.length <= max) {
    if (items.length === 1) return items[0];
    return `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;
  }
  const shown = items.slice(0, max);
  const extra = items.length - max;
  return `${shown.join(', ')} and ${extra} more bank${extra === 1 ? '' : 's'}`;
}

// Cross-links (discovery): this category in other provinces, other categories
// in this province, plus links up to the two parent ledgers.
const sameCatOtherProv = PROVINCES.filter(
  (p) =>
    p !== province &&
    saJobs().some((j) => j.categorySlug === slug && j.locations[0]?.province === p),
).map((p) => ({ name: p, slug: PROVINCE_SLUGS[p] }));

const otherCatsHere = (Object.entries(CATEGORY_SLUGS) as Array<[Category, string]>)
  .filter(
    ([, cs]) =>
      cs !== slug && saJobs().some((j) => j.categorySlug === cs && j.locations[0]?.province === province),
  )
  .map(([cn, cs]) => ({ name: cn, slug: cs }));

const title = `${name} bank vacancies in ${province} — ${total} open — mybankjobs`;
const description = `${total} open ${name} bank ${noun} in ${province}${
  bankPhrase ? ` at ${bankPhrase}` : ''
} — official listings, updated a few times a day.`;
---

<Base title={title} description={description}>
  <a class="backlink" href={`/browse/${slug}/`}>← All {name} vacancies</a>
  <p class="eyebrow">Browse by category &amp; province</p>
  <h1>{name} bank vacancies in {province} <span class="mono">({total})</span></h1>
  <p class="lede">
    {total} open {noun}{bankPhrase && <> at {bankPhrase}</>} — updated three times a day.
  </p>

  <ul class="joblist">
    {
      jobs.map((job) => (
        <JobRow
          slug={job.slug}
          title={job.title}
          brand={job.brand}
          category={job.category}
          primaryLocation={job.primaryLocation}
          postedDate={job.postedDate}
          firstSeen={job.firstSeen}
        />
      ))
    }
  </ul>

  <nav class="crosslinks" aria-label="Related listings">
    {
      sameCatOtherProv.length > 0 && (
        <p class="quick">
          {name} elsewhere:
          {sameCatOtherProv.map((p) => (
            <a href={`/browse/${slug}/${p.slug}/`}>{p.name}</a>
          ))}
        </p>
      )
    }
    {
      otherCatsHere.length > 0 && (
        <p class="quick">
          Other categories in {province}:
          {otherCatsHere.map((c) => (
            <a href={`/browse/${c.slug}/${provSlug}/`}>{c.name}</a>
          ))}
        </p>
      )
    }
    <p class="quick">
      <a href={`/browse/${slug}/`}>All {name} vacancies</a>
      <a href={`/vacancies/${provSlug}/`}>All vacancies in {province}</a>
    </p>
  </nav>
</Base>
