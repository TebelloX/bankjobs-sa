---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../../layouts/Base.astro';
import JobRow from '../../../components/JobRow.astro';
import Pager from '../../../components/Pager.astro';
import { CATEGORY_SLUGS } from '@bankjobs/core';
import type { Category } from '@bankjobs/core';
import { saJobs, internationalJobs } from '../../../lib/data';
import type { FullJob } from '../../../lib/data';

// One paginated route per category, 20 SA rows a page. `[...page]` keeps the
// old bare URLs (/browse/sales/) as page 1 and adds /browse/sales/2/ …
// 'international' is NOT a category slug, so the static browse/international
// route is never shadowed or regenerated here.
export const getStaticPaths = (({ paginate }) => {
  return (Object.entries(CATEGORY_SLUGS) as Array<[Category, string]>).flatMap(([name, slug]) => {
    const jobs = saJobs().filter((j) => j.categorySlug === slug);
    return paginate(jobs, {
      params: { category: slug },
      props: { name, slug },
      pageSize: 20,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<FullJob>;
  name: Category;
  slug: string;
}

const { page, name, slug } = Astro.props;
const isFirst = page.currentPage === 1;

// Counts reflect the whole category (page.total), not just this page's slice.
const total = page.total;
const noun = total === 1 ? 'vacancy' : 'vacancies';
const intlCount = internationalJobs().filter((j) => j.categorySlug === slug).length;

const title = isFirst
  ? `${name} vacancies — myBankjobs`
  : `${name} vacancies — page ${page.currentPage} — myBankjobs`;
const baseDesc = `Open ${name} vacancies at South African banks — official listings, updated a few times a day.`;
const description = isFirst ? baseDesc : `${baseDesc} — page ${page.currentPage}`;
---

<Base title={title} description={description}>
  <a class="backlink" href="/">← All vacancies</a>
  <p class="eyebrow">Browse by category</p>
  <h1>{name} <span class="mono muted">— {total} open {noun}</span></h1>

  {
    page.data.length > 0 ? (
      <ul class="joblist">
        {page.data.map((job) => (
          <JobRow
            slug={job.slug}
            title={job.title}
            brand={job.brand}
            category={job.category}
            primaryLocation={job.primaryLocation}
            postedDate={job.postedDate}
          />
        ))}
      </ul>
    ) : (
      <p class="list-empty">No open {name} vacancies right now.</p>
    )
  }

  <Pager page={page} />

  {
    intlCount > 0 && (
      <p class="intl-link">
        <a href="/browse/international">
          {`${intlCount} international ${name} ${intlCount === 1 ? 'role' : 'roles'} at these banks →`}
        </a>
      </p>
    )
  }
</Base>
