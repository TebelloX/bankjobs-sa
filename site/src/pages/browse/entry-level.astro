---
import Base from '../../layouts/Base.astro';
import JobRow from '../../components/JobRow.astro';
import { BRANDS, CATEGORY_SLUGS, isEarlyCareers, isEntryLevel } from '@bankjobs/core';
import type { Category } from '@bankjobs/core';
import { allOpenJobs } from '../../lib/data';
import { BANK_SLUGS } from '../../lib/banks';

// A STATIC route living beside the dynamic browse/[category] one, exactly as
// browse/graduate-programmes.astro does: 'entry-level' is not one of the ten
// CATEGORY_SLUGS, so the dynamic route never emits this URL and there is
// nothing to shadow. Entry level is deliberately not an eleventh category — a
// teller is still a Branch & retail job, and the categories partition the
// ledger.
//
// This page is ALWAYS GENERATED, even with zero rows, on the same grounds as
// the graduate hub. Everywhere else an empty ledger means no page at all (the
// sitemap only lists real ledgers), but frontline hiring arrives in waves, so a
// page that vanished between them would be a dead link exactly when people start
// looking. It stays put and says honestly which state it is in.
//
// `!isEarlyCareers` is the partition between the two hubs, not a refinement of
// the predicate: Absa posts "Learnership Opportunity: ... Microinsurance Sales
// Consultant", which reads as both, and learnerships, internships and graduate
// programmes belong to /browse/graduate-programmes/. The two pages cross-link.
//
// No /international sibling and no intl link: the roles this page collects are
// branch-floor roles in South Africa. The graduate hub keeps its own.
const jobs = allOpenJobs().filter(
  (job) => job.country === 'ZA' && isEntryLevel(job.title) && !isEarlyCareers(job.title),
);

const total = jobs.length;
const roles = total === 1 ? 'role' : 'roles';

// Banks with an entry-level role open right now, in canonical core order — the
// frontline openings cluster in a handful of banks, so this is a real shortcut
// to the rest of that bank's ledger. Omitted when nothing is open.
const banksHere = BRANDS.filter((name) => jobs.some((j) => j.brand === name)).map((name) => ({
  name,
  slug: BANK_SLUGS[name],
}));

// Every category, not just the ones represented above: the category pages all
// exist regardless of their counts, and this row has to stay useful in the
// months when the ledger above is empty.
const categories = (Object.entries(CATEGORY_SLUGS) as Array<[Category, string]>).map(
  ([name, slug]) => ({ name, slug }),
);

const title =
  total > 0
    ? `Entry-level bank jobs in South Africa (${total}) — mybankjobs`
    : 'Entry-level bank jobs in South Africa — mybankjobs';
const description =
  total > 0
    ? `${total} entry-level ${total === 1 ? 'vacancy' : 'vacancies'} at South African banks — tellers, service consultants and other junior, frontline roles. Official listings, updated a few times a day.`
    : 'Entry-level jobs at South African banks — tellers, service consultants and other junior, frontline roles. None are open right now — new roles appear here as soon as the banks post them.';
---

<Base title={title} description={description}>
  <a class="backlink" href="/">← All vacancies</a>
  <p class="eyebrow">Entry level</p>
  <h1>Entry-level bank jobs <span class="mono muted">({total})</span></h1>
  <p class="lede">
    {
      total > 0
        ? `${total} entry-level ${roles} open in South Africa — tellers, service consultants and other junior, frontline roles at the banks we cover, updated three times a day.`
        : 'Tellers, service consultants and other junior, frontline roles at the banks we cover. None are open in South Africa right now.'
    }
  </p>

  {
    total > 0 ? (
      <ul class="joblist">
        {jobs.map((job) => (
          <JobRow
            slug={job.slug}
            title={job.title}
            brand={job.brand}
            category={job.category}
            primaryLocation={job.primaryLocation}
            postedDate={job.postedDate}
            firstSeen={job.firstSeen}
          />
        ))}
      </ul>
    ) : (
      <p class="list-empty">
        No entry-level roles are open right now. Frontline hiring comes and goes in waves — new
        roles appear here as soon as the banks post them.
      </p>
    )
  }

  <p class="banks-note">
    Requirements vary by role and bank — matric is the usual minimum, and some roles ask for FAIS
    accreditation or prior experience. The bank's own posting is the authority on what it wants, and
    applications go to the bank's own system, the same as every other vacancy on the site.
  </p>

  <p class="intl-link">
    <a href="/browse/graduate-programmes/">
      Looking for graduate programmes, learnerships or internships? They have their own page →
    </a>
  </p>

  <nav class="crosslinks" aria-label="Related listings">
    {
      banksHere.length > 0 && (
        <p class="quick">
          Banks hiring entry level:
          {banksHere.map((b) => (
            <a href={`/banks/${b.slug}/`}>{b.name}</a>
          ))}
        </p>
      )
    }
    <p class="quick">
      Browse by category:
      {categories.map((c) => <a href={`/browse/${c.slug}/`}>{c.name}</a>)}
    </p>
  </nav>
</Base>
