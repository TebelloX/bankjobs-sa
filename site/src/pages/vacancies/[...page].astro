---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import JobRow from '../../components/JobRow.astro';
import Pager from '../../components/Pager.astro';
import { PROVINCES } from '@bankjobs/core';
import type { Province } from '@bankjobs/core';
import { saJobs, meta } from '../../lib/data';
import type { FullJob } from '../../lib/data';
import { PROVINCE_SLUGS } from '../../lib/provinces';
import { PAGE_CITIES } from '../../lib/cities';

// One statement page of 20 rows per page. saJobs() is already sorted
// postedDate desc (nulls last). `[...page]` gives page 1 the bare
// /vacancies/ URL and later pages /vacancies/2/, /vacancies/3/ …
export const getStaticPaths = (({ paginate }) => {
  return paginate(saJobs(), { pageSize: 20 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<FullJob>;
}

const { page } = Astro.props;
const isFirst = page.currentPage === 1;

// The count in the h1 is the full South African total (page.total is the same
// on every page), so every page reads "Open vacancies in South Africa (259)".
const base = 'Open vacancies in South Africa';
const heading = isFirst ? base : `${base} — page ${page.currentPage}`;
const title = `${heading} — mybankjobs`;

const baseDesc =
  "Every open vacancy at South African banks — official listings straight from the banks' own career systems, updated a few times a day.";
const description = isFirst ? baseDesc : `${baseDesc} — page ${page.currentPage}`;

// Page 1 only: a compact "by province" link row to the province landing pages
// (discovery — those pages need inbound links to rank). Only provinces with an
// open SA job get a page, so only those are listed.
const provinceLinks = isFirst
  ? PROVINCES.filter((p) => saJobs().some((j) => j.locations[0]?.province === p)).map((p) => ({
      name: p as Province,
      slug: PROVINCE_SLUGS[p],
    }))
  : [];

// Page 1 only, beside the province row: the city landing pages, which need the
// same inbound links to rank. lib/cities.ts decides which cities earn a page (a
// job floor keeps one-vacancy towns out) and hands them over biggest ledger
// first, so this row leads with the metros a job seeker is most likely to want.
const cityLinks = isFirst ? PAGE_CITIES : [];
---

<Base title={title} description={description}>
  <a class="backlink" href="/">← Home</a>
  <p class="eyebrow">All vacancies</p>
  <h1>{base} <span class="mono">({page.total})</span></h1>

  {
    page.data.length > 0 ? (
      <ul class="joblist">
        {page.data.map((job) => (
          <JobRow
            slug={job.slug}
            title={job.title}
            brand={job.brand}
            category={job.category}
            primaryLocation={job.primaryLocation}
            postedDate={job.postedDate}
          />
        ))}
      </ul>
    ) : (
      <p class="list-empty">No open vacancies right now — check back soon.</p>
    )
  }

  <Pager page={page} />

  {
    provinceLinks.length > 0 && (
      <p class="quick">
        By province:
        {provinceLinks.map((p) => (
          <a href={`/vacancies/${p.slug}/`}>{p.name}</a>
        ))}
      </p>
    )
  }

  {
    cityLinks.length > 0 && (
      <p class="quick">
        By city:
        {cityLinks.map((c) => (
          <a href={`/vacancies/${c.slug}/`}>{c.name}</a>
        ))}
      </p>
    )
  }

  {
    isFirst && meta.totalInternational > 0 && (
      <p class="intl-link">
        <a href="/browse/international">
          {`${meta.totalInternational} international ${
            meta.totalInternational === 1 ? 'role' : 'roles'
          } at these banks →`}
        </a>
      </p>
    )
  }
</Base>
