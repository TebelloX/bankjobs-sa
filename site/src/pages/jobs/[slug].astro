---
import Base from '../../layouts/Base.astro';
import JobRow from '../../components/JobRow.astro';
import { allOpenJobs, formatDate } from '../../lib/data';
import { mailtoShareHref, shareLabel, whatsappShareHref } from '../../lib/share';
import { pickRelated } from '../../lib/related';
import { countryName } from '@bankjobs/core';
import type { FullJob } from '../../lib/data';

export function getStaticPaths() {
  return allOpenJobs().map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

interface Props {
  job: FullJob;
}

const { job } = Astro.props;
const isInternational = job.country !== 'ZA';
const loc = job.locations[0];

// Eyebrow: brand · category. Meta line: location · posted date · employmentType.
const eyebrow = `${job.brand} · ${job.category}`;
const metaParts: string[] = [];
if (job.primaryLocation) metaParts.push(job.primaryLocation);
if (job.postedDate) metaParts.push(`posted ${formatDate(job.postedDate)}`);
if (job.employmentType) metaParts.push(job.employmentType);
const metaLine = metaParts.join(' · ');

// "More like this": up to 5 sibling vacancies, tiered by province → brand →
// country → brand (see lib/related.ts), drawn from the whole open ledger in
// snapshot order. Deterministic — no shuffling — so an unchanged snapshot
// rebuilds to an identical page. An empty pick renders no section at all.
const related = pickRelated(job, allOpenJobs());

// Share links. The URL is built exactly as Base.astro builds the canonical
// <link>, so a shared link is byte-identical to the canonical one — no
// tracking params, no alternate host. The client script reads it back off the
// data- attribute rather than knowing the domain itself.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareSubject = { title: job.title, brand: job.brand, url: canonicalUrl };
const shareTitle = shareLabel(job.title, job.brand);
const whatsappHref = whatsappShareHref(shareSubject);
const emailHref = mailtoShareHref(shareSubject);

// validThrough = lastSeen + 7 days (ISO), per plan §10.
const validThrough = new Date(new Date(job.lastSeen).getTime() + 7 * 86_400_000).toISOString();

const EMPLOYMENT_TYPE_MAP: Record<string, string> = {
  'Full time': 'FULL_TIME',
  'Part time': 'PART_TIME',
};
const mappedEmployment = job.employmentType ? EMPLOYMENT_TYPE_MAP[job.employmentType] : undefined;

const address: Record<string, string> = { '@type': 'PostalAddress', addressCountry: job.country };
if (loc?.city) address.addressLocality = loc.city;
if (loc?.province) address.addressRegion = loc.province;

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org/',
  '@type': 'JobPosting',
  title: job.title,
  // Google's JobPosting docs want the complete description (HTML allowed) here,
  // not a teaser. descriptionHtml is already sanitized by the ingest pipeline;
  // the page meta description keeps the short excerpt.
  description: job.descriptionHtml,
  validThrough,
  hiringOrganization: { '@type': 'Organization', name: job.brand },
  jobLocation: { '@type': 'Place', address },
  directApply: false,
};
// datePosted is required for Google's job rich results. Sources that publish
// no usable date (Investec's is templated junk; the odd Nedbank enrichment
// miss) fall back to firstSeen — accurate to within ~8h at 3 crawls/day, and
// our honest best knowledge of when the posting appeared. The VISIBLE posted
// date elsewhere in the UI stays real-data-only; this is markup-only.
jsonLd.datePosted = job.postedDate ?? job.firstSeen.slice(0, 10);
if (mappedEmployment) jsonLd.employmentType = mappedEmployment;

// The JSON now embeds job HTML inside a <script> block: a literal "</script>"
// in the data would end the block early, so escape every "<" as \u003c
// (identical JSON, inert in HTML).
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<Base title={`${job.title} — ${job.brand} | mybankjobs`} description={job.excerpt} narrow>
  <a class="backlink" href="/">← All vacancies</a>

  {isInternational && <p class="badge">International — {countryName(job.country)}</p>}

  <p class="detail-eyebrow">{eyebrow}</p>
  <h1 class="detail-title display">{job.title}</h1>
  <hr class="detail-rule" />
  {metaLine && <p class="detail-meta">{metaLine}</p>}

  <div class="jobdesc" set:html={job.descriptionHtml} />

  <div class="applybox">
    <a class="btn btn--block" href={job.applyUrl} rel="nofollow noopener" target="_blank">
      Apply on {job.brand}'s official site
    </a>
    <p class="note">
      You'll apply on the bank's own system. We never handle applications or CVs.
    </p>

    {/* Save-for-later. Everything the saved page needs to render this row after
        the vacancy closes rides on the data- attributes; the script below reads
        them back, so nothing about the shortlist is known server-side. The
        button ships `hidden` and is revealed only where a localStorage write
        actually succeeds — a no-JS or storage-blocked visitor never sees a
        control that could not remember anything. */}
    <div
      class="saveline"
      data-save-job
      data-job-id={job.id}
      data-job-slug={job.slug}
      data-job-title={job.title}
      data-job-brand={job.brand}
      data-job-category={job.category}
      data-job-location={job.primaryLocation ?? ''}
      data-job-posted={job.postedDate ?? ''}
    >
      <button class="share-btn save-btn" type="button" data-save-toggle hidden
        >save this vacancy</button
      >
      <span class="sr-only" role="status" data-save-status></span>
    </div>

    {/* WhatsApp and email are plain anchors — they work with JavaScript off,
        which matters on the cheap/low-data handsets a lot of this audience
        uses. The native-share button ships `hidden` and is revealed by the
        script below only where the browser actually supports it. */}
    <div class="share" data-share-url={canonicalUrl} data-share-label={shareTitle}>
      <p class="share-title">share this vacancy</p>
      <div class="share-actions">
        <a class="share-btn" href={whatsappHref} target="_blank" rel="noopener nofollow">whatsapp</a>
        <a class="share-btn" href={emailHref}>email</a>
        <button class="share-btn" type="button" data-share-native hidden>share</button>
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 class="sec-eyebrow" id="related-h">
          More like this
        </h2>
        <ul class="joblist">
          {related.map((r) => (
            <JobRow
              slug={r.slug}
              title={r.title}
              brand={r.brand}
              category={r.category}
              primaryLocation={r.primaryLocation}
              postedDate={r.postedDate}
            />
          ))}
        </ul>
      </section>
    )
  }

  <script type="application/ld+json" set:html={jsonLdString} is:inline />

  <script>
    // Progressive enhancement for the share block: the native-share button
    // renders `hidden` and is only unhidden where the API exists, so a no-JS
    // (or unsupported) visitor never sees a dead control. Bundled by Astro
    // into an external same-origin file (assetsInlineLimit: 0), which
    // script-src 'self' already allows — no inline script, no third-party SDK.
    const box = document.querySelector<HTMLElement>('.share');
    const url = box?.dataset.shareUrl;
    const label = box?.dataset.shareLabel;

    if (box && url && label) {
      const nativeBtn = box.querySelector<HTMLButtonElement>('[data-share-native]');

      if (nativeBtn && typeof navigator.share === 'function') {
        nativeBtn.hidden = false;
        nativeBtn.addEventListener('click', () => {
          // Dismissing the OS share sheet rejects with AbortError — expected
          // user action, not an error worth surfacing.
          navigator.share({ title: label, text: label, url }).catch(() => {});
        });
      }
    }
  </script>

  <script>
    // Progressive enhancement for the save toggle, same shape as the share
    // script above: the button ships `hidden` and is only revealed once
    // getLocalStorage() has proved a write round-trips (it probes, because
    // Safari's private mode hands out a localStorage whose setItem always
    // throws). Bundled by Astro into an external same-origin file
    // (assetsInlineLimit: 0) — no inline script, so `script-src 'self'` holds.
    //
    // lib/savedJobs.ts is dependency-free, so importing it here costs the page
    // nothing but the module itself: no job snapshot follows it into the bundle.
    import { getLocalStorage, isSaved, toggleSaved } from '../../lib/savedJobs';

    const box = document.querySelector<HTMLElement>('[data-save-job]');
    const btn = box?.querySelector<HTMLButtonElement>('[data-save-toggle]');
    const storage = getLocalStorage();

    if (box && btn && storage) {
      const status = box.querySelector<HTMLElement>('[data-save-status]');
      const d = box.dataset;
      // Empty strings mean "the source gave us none" — stored as null, exactly
      // as the snapshot carries them, so a saved row renders like a ledger row.
      const entry = {
        id: d.jobId ?? '',
        slug: d.jobSlug ?? '',
        title: d.jobTitle ?? '',
        brand: d.jobBrand ?? '',
        category: d.jobCategory ?? '',
        primaryLocation: d.jobLocation || null,
        postedDate: d.jobPosted || null,
      };

      if (entry.id && entry.slug && entry.title) {
        /** Label + pressed state always mirror what is actually persisted. */
        function paint(saved: boolean): void {
          btn!.textContent = saved ? 'saved ✓' : 'save this vacancy';
          btn!.setAttribute('aria-pressed', saved ? 'true' : 'false');
          btn!.classList.toggle('is-saved', saved);
        }

        paint(isSaved(storage, entry.id));
        btn.hidden = false;

        btn.addEventListener('click', () => {
          const { saved, ok } = toggleSaved(storage, entry);
          paint(saved);
          if (!status) return;
          // Announced to screen readers only — the visible label already
          // carries the state for everyone else.
          if (!ok) status.textContent = 'could not save — this browser is not storing it';
          else status.textContent = saved ? 'saved to your list' : 'removed from your list';
        });
      }
    }
  </script>
</Base>
