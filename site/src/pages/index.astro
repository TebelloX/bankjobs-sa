---
import Base from '../layouts/Base.astro';
import JobRow from '../components/JobRow.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { allOpenJobs, saJobs, meta, formatDate } from '../lib/data';
import { insights } from '../lib/insights';
import { sastStatementDate } from '../lib/freshness';
import { BRANDS } from '@bankjobs/core';
import { BANK_SLUGS } from '../lib/banks';

const sa = saJobs();

// The four most recent SA jobs for the signature statement card.
const statement = sa.slice(0, 4);

// The homepage shows the 20 most recent SA jobs; the full ledger lives at
// /vacancies/. The "browse all" row below carries the true total (sa.length).
const latest = sa.slice(0, 20);

// The statement header date and the per-row 'posted today'/'posted 1d'
// wording are both relative to the day the page is VIEWED, so — like the
// header freshness label in Base.astro — they are re-rendered by the client
// script at the bottom of this file. The build bakes the build-day date and
// absolute 'posted 23 Jul' rows as the no-JS fallback.
const statementDate = sastStatementDate();

// Live rows: one per BRAND with open roles, largest ledger first, each linking
// to its own /banks/<slug>/ landing page. Brands — not sources — because a
// source can carry several: the firstrand source is FNB, RMB, WesBank and
// FirstRand, and a job seeker looking for FNB should land on an FNB ledger.
// Brands are enumerated from core's BRANDS, never from meta.sources.
//
// Displayed counts are SOUTH AFRICAN roles only, so the ledger sums to the
// same number as the header and the "Open vacancies in South Africa" list —
// an all-countries count would make the page contradict itself. Liveness still
// comes from the all-countries count (the same predicate the /banks/ pages
// use), so a brand whose SA count happens to be 0 stays a live row with a real
// page rather than silently disappearing.
const saCountByBrand = new Map<string, number>();
for (const job of sa) {
  saCountByBrand.set(job.brand, (saCountByBrand.get(job.brand) ?? 0) + 1);
}
const liveBrands = new Set(allOpenJobs().map((j) => j.brand));
const liveBanks = BRANDS.filter((b) => liveBrands.has(b))
  .map((b) => ({
    name: b,
    slug: BANK_SLUGS[b],
    count: saCountByBrand.get(b) ?? 0,
  }))
  .sort((a, b) => b.count - a.count);

// The ledger lists only banks with roles open today. A source whose feed is
// empty (GoTyme's adapter is built but its board is bare) is simply absent —
// an earlier "coming soon" row advertised a bank that had nothing to click,
// which read as a broken listing rather than an honest one.

// Per-day SA additions, baked into the page for the client to total against
// the visitor's own last visit — the whole "N added since your last visit"
// line is reckoned in the browser, with no fetch and no server state.
//
// The OPENING DAY is excluded, the same exclusion windowSums makes on
// /insights/: tracking began mid-life, so trackingSince's `added` is the import
// of an existing ledger, not a day's hiring, and counting it would greet a
// returning visitor with several hundred imaginary new roles. Days with no
// additions are dropped (they add nothing to a sum) and only the last 30 days
// are kept — this block ships to every homepage visitor, and a gap longer than
// a month is not a "last visit" worth totalling.
const addedByDay: Record<string, number> = Object.fromEntries(
  insights.series
    .filter((d) => d.day !== insights.trackingSince)
    .slice(-30)
    .filter((d) => d.added > 0)
    .map((d) => [d.day, d.added]),
);
// ISO date keys and integer counts — no job data, no visitor data, nothing that
// can carry a '<' — so unlike the ld+json block on job pages this needs no
// escaping pass to stay inside its <script>.
const addedByDayJson = JSON.stringify(addedByDay);

// Source line for a statement row: 'Absa · Category[ · City]'.
function stSource(brand: string, category: string, city: string | null): string {
  return city ? `${brand} · ${category} · ${city}` : `${brand} · ${category}`;
}

const description =
  "Every official South African bank vacancy on one page. Listings come straight from the banks' own career systems — no agencies, no reposts. Apply on the bank's own site.";
---

<Base
  title="mybankjobs — Every official bank vacancy in South Africa"
  description={description}
  bleed
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Free · No ads · No agencies</p>
        <h1 class="hero-h">Every <em>official</em> bank vacancy in South&nbsp;Africa. One page.</h1>
        <p class="lede">
          We fetch listings straight from the banks' own career systems — no recruiter reposts, no
          duplicates, no expired ads. Every job links to the bank's official apply page.
        </p>

        <form class="search" role="search" action="/search" method="get">
          <label class="sr-only" for="q">Search job title or keyword</label>
          <input
            type="search"
            id="q"
            name="q"
            placeholder="Try “teller”, “developer”, “credit analyst”…"
            autocomplete="off"
          />
          <button type="submit" class="display">Search</button>
        </form>

        <p class="quick">
          Popular:
          <a href="/browse/branch-retail">Branch &amp; retail</a>
          <a href="/browse/software-it">Software &amp; IT</a>
          <a href="/browse/sales">Sales</a>
          <a href="/browse/graduate-programmes/">Graduate programmes</a>
          <a href="/browse/entry-level/">Entry-level</a>
          <a href="/search?q=Gauteng">Gauteng</a>
          <a href="/search?q=Western+Cape">Western Cape</a>
        </p>
      </div>

      <aside class="statement" aria-label="Most recent listings">
        <div class="st-head">
          <span class="t">Statement of vacancies</span>
          <span class="d" id="st-date">{statementDate}</span>
        </div>
        {
          statement.map((job) => (
            <div class="st-row">
              <p class="job">
                <a href={`/jobs/${job.slug}/`}>{job.title}</a>
                <span class="src">
                  {stSource(job.brand, job.category, job.locations[0]?.city ?? null)}
                </span>
              </p>
              <span class="when" data-posted-date={job.postedDate}>
                posted {formatDate(job.postedDate)}
              </span>
            </div>
          ))
        }
        <div class="st-foot">
          <span>{statement.length} of {meta.totalSA} shown</span>
          <span>source: banks' own systems</span>
        </div>
        <span class="stamp" aria-hidden="true">Direct from<br />the bank</span>
      </aside>
    </div>
  </section>

  <TrustStrip />

  <section class="section" aria-labelledby="coverage-h">
    <div class="wrap">
      <p class="sec-eyebrow">Coverage</p>
      <h2 id="coverage-h" class="sec-title">The banks on the statement</h2>
      {
        liveBanks.map((bank) => (
          <a class="bank-line" href={`/banks/${bank.slug}/`}>
            <span class="name">{bank.name}</span>
            <span class="dots" />
            <span class="count">
              {bank.count}
              <small>open roles</small>
            </span>
          </a>
        ))
      }
      {/* The counts above are today's; /insights/ is where the same ledger is
          totted up over time. Quiet on purpose — the job rows below are what a
          visitor came for. */}
      <p class="intl-link">
        <a href="/insights/">The figures behind the statement →</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="jobs-h">
    <div class="wrap">
      <p class="sec-eyebrow">Latest vacancies</p>
      <h2 id="jobs-h" class="sec-title">Latest vacancies in South Africa</h2>
      {/* Data, not code: type="application/json" is not an executable script
          type, so the CSP's script-src never governs it — the same reason the
          ld+json block on job pages can be inline. is:inline keeps Astro's
          bundler out of it. */}
      <script type="application/json" id="added-by-day" set:html={addedByDayJson} is:inline />
      {/* Filled and unhidden by the script below, only for a returning visitor
          with something to count. Ships empty so no-JS visitors — and everyone
          on their first visit — see no half-sentence. */}
      <p class="visit-note" id="visit-note" hidden><a href="/vacancies/"></a></p>
      {
        sa.length > 0 ? (
          <ul class="joblist">
            {latest.map((job) => (
              <JobRow
                slug={job.slug}
                title={job.title}
                brand={job.brand}
                category={job.category}
                primaryLocation={job.primaryLocation}
                postedDate={job.postedDate}
                firstSeen={job.firstSeen}
              />
            ))}
          </ul>
        ) : (
          <p class="list-empty">No open vacancies right now — check back soon.</p>
        )
      }

      {
        sa.length > 0 && (
          <a class="browse-all" href="/vacancies/">
            <span class="display">Browse all {sa.length} South African vacancies</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        )
      }

      {/* The other half of the visit-note story above: that line tells a
          returning visitor what they missed, this one offers to tell them
          without the return trip. Ships `hidden` — the same
          feature-detect-then-reveal idiom as the share and save buttons on job
          pages — and is revealed by the script below only when the browser can
          actually do push AND this build knows a Worker to register the
          subscription with. A static-search build (local dev, CI) has nowhere
          to POST it, so the control never appears rather than dying on click. */}
      <div class="push-line" data-push hidden>
        <p class="push-copy">
          New roles land here three times a day — get a notification when they do.
        </p>
        <div class="push-actions">
          <button class="share-btn push-btn" type="button" data-push-toggle
            >notify me of new vacancies</button
          >
          <span class="push-status" role="status" data-push-status></span>
        </div>
      </div>

      {
        meta.totalInternational > 0 && (
          <p class="intl-link">
            <a href="/browse/international">
              {`${meta.totalInternational} international ${
                meta.totalInternational === 1 ? 'role' : 'roles'
              } at these banks →`}
            </a>
          </p>
        )
      }
    </div>
  </section>

  <section class="how" aria-labelledby="honest-h">
    <div class="wrap section">
      <p class="sec-eyebrow">Method</p>
      <h2 id="honest-h" class="sec-title">How the statement stays honest</h2>
      <div class="how-grid">
        <div>
          <span class="k">FETCHED</span>
          <h3>Straight from the source</h3>
          <p>
            A few times a day we read each bank's own career system — the same listings you'd find
            on their site, gathered in one place.
          </p>
        </div>
        <div>
          <span class="k">VERIFIED</span>
          <h3>Closed jobs come down</h3>
          <p>
            When a vacancy disappears from the bank's system, it's removed here. Anything we can't
            re-confirm within 60 days is taken down regardless.
          </p>
        </div>
        <div>
          <span class="k">DATED</span>
          <h3>You can see the freshness</h3>
          <p>
            The “last updated” time at the top of every page is real. If our fetch ever breaks, the
            date will say so — we won't pretend.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Re-render the statement card's day-relative pieces against NOW, replacing
  // the baked build-day fallbacks: the header date becomes the viewing day and
  // each row's 'posted 23 Jul' becomes 'posted today'/'posted 1d'. Bundled by
  // Astro into an external same-origin file (assetsInlineLimit: 0), which
  // script-src 'self' already allows.
  //
  // Same rule as every other client bundle here: nothing imported reaches
  // lib/data.ts or lib/insights.ts, so no snapshot follows this to the browser.
  import { formatPostedRelative, sastStatementDate } from '../lib/freshness';
  import { getLocalStorage } from '../lib/savedJobs';
  import { recordVisit, sumAddedSince } from '../lib/visit';
  import {
    PUSH_API_BASE,
    getSubscription,
    pushSupported,
    subscribe,
    unsubscribe,
  } from '../lib/push';

  const stDate = document.getElementById('st-date');
  if (stDate) stDate.textContent = sastStatementDate();

  for (const el of document.querySelectorAll<HTMLElement>('.st-row .when[data-posted-date]')) {
    const rel = formatPostedRelative(el.dataset.postedDate ?? null);
    if (rel) el.textContent = `posted ${rel}`;
  }

  // "N added since your last visit" — totalled here, in the browser, from the
  // per-day counts baked into the page above. The figure is SOUTH AFRICAN
  // additions (the insights series is SA-scoped), like every other count on
  // this page. recordVisit is idempotent inside the session gap, so calling it
  // again after Base.astro's script has stamped this page view reads back the
  // same record rather than moving the clock.
  const note = document.getElementById('visit-note');
  const noteLink = note?.querySelector('a');
  const baked = document.getElementById('added-by-day')?.textContent;
  if (note && noteLink && baked) {
    let addedByDay: Record<string, number> = {};
    try {
      addedByDay = JSON.parse(baked) as Record<string, number>;
    } catch {
      addedByDay = {};
    }
    const added = sumAddedSince(addedByDay, recordVisit(getLocalStorage()).prev);
    if (added > 0) {
      // 'added' needs no plural form, so 1 and 200 read the same way.
      noteLink.textContent = `${added} added since your last visit →`;
      note.hidden = false;
    }
  }

  // Push opt-in. The block ships `hidden` and is unhidden only once BOTH gates
  // pass — the browser can actually do push, and this build carries a Worker
  // origin to register the subscription with — so a control that could not work
  // is never shown. The label is painted from the browser's REAL subscription
  // state before the reveal, so a visitor who already turned notifications on
  // never sees "notify me" flash first.
  const pushBox = document.querySelector<HTMLElement>('[data-push]');
  const pushBtn = pushBox?.querySelector<HTMLButtonElement>('[data-push-toggle]');
  const pushStatus = pushBox?.querySelector<HTMLElement>('[data-push-status]');

  if (pushBox && pushBtn && pushSupported() && PUSH_API_BASE) {
    /** Label and pressed state always mirror what the browser is subscribed to. */
    const paintPush = (on: boolean): void => {
      pushBtn.textContent = on
        ? 'notifications on — tap to turn off'
        : 'notify me of new vacancies';
      pushBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      pushBtn.classList.toggle('is-on', on);
    };
    const sayPush = (text: string): void => {
      if (pushStatus) pushStatus.textContent = text;
    };
    /** Never leave the toggle disabled, whatever the attempt did. */
    const releasePush = (): void => {
      pushBtn.disabled = false;
    };

    getSubscription()
      .then((subscription) => {
        paintPush(subscription !== null);
        // A browser-level block is worth saying up front: the button would
        // otherwise look available and do nothing a visitor could see.
        if (!subscription && Notification.permission === 'denied') {
          sayPush('notifications are blocked in your browser settings');
        }
        pushBox.hidden = false;
      })
      .catch(() => {
        // Cannot read the state, so cannot label the control honestly: leave it
        // hidden rather than guess.
      });

    pushBtn.addEventListener('click', () => {
      const wasOn = pushBtn.classList.contains('is-on');
      pushBtn.disabled = true;
      sayPush(wasOn ? 'turning notifications off…' : 'asking your browser…');

      if (wasOn) {
        unsubscribe(PUSH_API_BASE)
          .then(() => {
            paintPush(false);
            sayPush('notifications off');
          })
          .catch(() => sayPush('could not turn notifications off — try again'))
          .finally(releasePush);
        return;
      }

      subscribe(PUSH_API_BASE)
        .then((result) => {
          paintPush(result === 'subscribed');
          if (result === 'subscribed') sayPush('on — the next digest comes here');
          else if (result === 'denied') {
            // Dismissing the prompt and blocking the site are different
            // answers, and only one of them is fixable in browser settings.
            sayPush(
              Notification.permission === 'denied'
                ? 'notifications are blocked in your browser settings'
                : 'nothing turned on — the prompt was dismissed',
            );
          } else sayPush('could not turn notifications on — try again');
        })
        .catch(() => sayPush('could not turn notifications on — try again'))
        .finally(releasePush);
    });
  }
</script>
