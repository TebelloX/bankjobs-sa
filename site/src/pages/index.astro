---
import Base from '../layouts/Base.astro';
import JobRow from '../components/JobRow.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { saJobs, meta } from '../lib/data';

const sa = saJobs();
const absa = meta.sources.find((s) => s.id === 'absa');

// Real per-source coverage from meta, then the banks we don't yet cover.
const comingSoon = ['Standard Bank', 'FNB · RMB · WesBank', 'Nedbank', 'Capitec'];

const description =
  "Every official South African bank vacancy on one page. Listings come straight from the banks' own career systems — no agencies, no reposts. Apply on the bank's own site.";
---

<Base
  title="BankJobs SA — Every official bank vacancy in South Africa"
  description={description}
>
  <section>
    <p class="eyebrow">Free · No ads · No agencies</p>
    <h1>Every official bank vacancy in South Africa. One page.</h1>
    <p class="lede">
      We fetch listings straight from the banks' own career systems — no recruiter reposts, no
      duplicates, no expired ads. Every job links to the bank's official apply page.
    </p>

    <form class="searchform" role="search" action="/search" method="get">
      <label class="sr-only" for="q">Search job title or keyword</label>
      <input
        type="search"
        id="q"
        name="q"
        placeholder="Try “teller”, “developer”, “credit analyst”…"
        autocomplete="off"
      />
      <button type="submit" class="btn">Search</button>
    </form>
  </section>

  <TrustStrip />

  <section aria-labelledby="coverage-h">
    <p class="eyebrow">Coverage</p>
    <h2 id="coverage-h">The banks we cover</h2>
    <ul class="coverage">
      {
        absa && (
          <li>
            <span class="name">{absa.name}</span>
            <span class="count tnum">{absa.count} open roles</span>
          </li>
        )
      }
      {
        comingSoon.map((name) => (
          <li class="soon">
            <span class="name">{name}</span>
            <span class="count">coming soon</span>
          </li>
        ))
      }
    </ul>
    <p class="small muted" style="margin-top:0.9rem;max-width:60ch">
      Counts update with every fetch. A bank listed as “coming soon” is one we're still building a
      reliable, respectful connection to — we'd rather show nothing than show stale jobs.
    </p>
  </section>

  <section aria-labelledby="jobs-h">
    <h2 id="jobs-h">Open vacancies in South Africa <span class="muted tnum">({sa.length})</span></h2>
    {
      sa.length > 0 ? (
        <ul class="joblist">
          {sa.map((job) => (
            <JobRow
              slug={job.slug}
              title={job.title}
              brand={job.brand}
              category={job.category}
              primaryLocation={job.primaryLocation}
              postedDate={job.postedDate}
            />
          ))}
        </ul>
      ) : (
        <p class="muted">No open vacancies right now — check back soon.</p>
      )
    }

    {
      meta.totalInternational > 0 && (
        <p style="margin-top:1.25rem">
          <a href="/browse/international">
            {`${meta.totalInternational} international ${
              meta.totalInternational === 1 ? 'role' : 'roles'
            } at these banks →`}
          </a>
        </p>
      )
    }
  </section>

  <section aria-labelledby="honest-h">
    <p class="eyebrow">Method</p>
    <h2 id="honest-h">How we keep it honest</h2>
    <div class="trio">
      <div>
        <span class="k">FETCHED</span>
        <h3>Straight from the source</h3>
        <p>
          A few times a day we read each bank's own career system — the same listings you'd find on
          their site, gathered in one place.
        </p>
      </div>
      <div>
        <span class="k">VERIFIED</span>
        <h3>Closed jobs come down</h3>
        <p>
          When a vacancy disappears from the bank's system, it's removed here. Anything we can't
          re-confirm within 60 days is taken down regardless.
        </p>
      </div>
      <div>
        <span class="k">DATED</span>
        <h3>You can see the freshness</h3>
        <p>
          The “last updated” time at the top of every page is real. If our fetch ever breaks, the
          date will say so — we won't pretend.
        </p>
      </div>
    </div>
  </section>
</Base>
