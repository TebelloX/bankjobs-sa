# BankJobs SA — Cloudflare Pages response headers (project: bankjobs-sa).
# Astro copies site/public/* into dist/, and Pages serves this _headers file as
# per-path response headers. Applied to every path via the /* pattern below.
#
# The Content-Security-Policy was derived from the ACTUAL built dist/ output in
# both build modes (plain `pnpm build` = static, and PUBLIC_SEARCH_MODE=api =
# production), not guessed. Notes per directive:
#
#   default-src 'none'  Deny every resource class by default; open each one below
#                       only as far as the built output actually needs.
#
#   script-src          The site ships NO third-party JS and NO external script
#                       files. The one executable inline script is Astro's
#                       hoisted search island (site/src/pages/search.astro),
#                       which Astro inlines into /search's HTML instead of
#                       emitting a file — so it is allow-listed by SHA-256 hash
#                       rather than 'unsafe-inline'. Two hashes are listed
#                       because the inlined code differs by build mode:
#                         sha256-BKyM… = api build    (production deploy)
#                         sha256-duOx… = static build  (CI / preview)
#                       REGENERATE both if search.astro or the Astro/Vite
#                       toolchain changes (the search island would otherwise be
#                       CSP-blocked). To recompute, sha256 the exact bytes
#                       between <script type="module"> and </script> in
#                       dist/search/index.html and base64-encode. 'self' is kept
#                       to cover any future same-origin external script.
#                       (Note: <script type="application/ld+json"> blocks are
#                       data, not executable, so they are NOT covered here.)
#
#   style-src 'self'    One same-origin stylesheet under /_astro/. No inline
#                       <style> blocks and no style= attributes exist anywhere
#                       (job-description HTML is sanitised with an empty
#                       attribute allowlist, so it can carry no inline styles).
#
#   img-src 'self' data:  No <img> elements in the HTML, but global.css paints a
#                       data:image/svg+xml noise texture as a background-image.
#
#   font-src 'self'     Self-hosted @fontsource woff2/woff under /_astro/. No
#                       web-font origins.
#
#   connect-src         Static mode fetches same-origin /data/jobs.json; api mode
#                       fetches the search Worker. The Worker origin is hard-coded
#                       here BY NECESSITY — a static _headers file cannot read it
#                       from PUBLIC_API_BASE at deploy time. Keep this origin in
#                       sync with the site's PUBLIC_API_BASE.
#
#   form-action 'self'  The homepage search box is a same-origin GET
#                       <form action="/search">; 'none' would block its submit.
#
#   frame-ancestors 'none' + object-src 'none' + base-uri 'self'
#                       Hardening: not framable, no plugins, no <base> hijack.
#                       upgrade-insecure-requests upgrades any stray http URL.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-BKyMcghvdHRY0DNydEhSSWgo2xtpJdFW5pvkjMzARKE=' 'sha256-duOxzH8TU6GCz3YAOLq1Z9ZyYJhJv8lPQaA6pmrnSj0='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://bankjobs-api.tebello-namo.workers.dev; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
