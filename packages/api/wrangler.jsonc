{
  "name": "bankjobs-api",
  "main": "src/index.ts",
  // Pinned within the runtime bundled by @cloudflare/vitest-pool-workers@0.8.71
  // (miniflare 4.20250906.x). Bump on deploy if a newer feature is needed.
  "compatibility_date": "2025-09-01",
  // Serve on the account's workers.dev subdomain (bankjobs-api.tebello-namo.
  // workers.dev) — explicit so deploys don't warn about the fallback. Kept
  // alongside the custom domain so the old origin never breaks mid-transition.
  "workers_dev": true,
  // Custom domain on the mybankjobs.co.za zone (same Cloudflare account).
  // wrangler creates the DNS record + cert on deploy. If a CI deploy fails
  // attaching this, the API token needs Zone → Workers Routes → Edit for the
  // zone (account-level Workers Scripts:Edit alone may not cover domains).
  "routes": [{ "pattern": "api.mybankjobs.co.za", "custom_domain": true }],
  // Deploy id for cache.ts's deploy-scoped cache keys: a deploy doesn't purge
  // caches.default, so keys are salted with the version id to orphan stale
  // entries the moment a fix rolls out.
  "version_metadata": { "binding": "VERSION" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bankjobs",
      // DEPLOY-TIME FILL: replace with the real id from `wrangler d1 create bankjobs`.
      // Ignored locally — miniflare/vitest simulate D1 regardless of this value.
      "database_id": "1ed5662e-2fab-402b-96d1-bac8175a52a6",
    },
  ],
  // route / custom domain intentionally unset — a deploy decision.
}
