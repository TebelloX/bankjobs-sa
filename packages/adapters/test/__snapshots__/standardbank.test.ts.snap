exports[`standardbankAdapter.normalize — snapshots > normalizes 744000138697014 1`] = `
{
  "applyUrl": "https://jobs.smartrecruiters.com/StandardBankGroup/744000138697014-head-credit-risk-business-and-commercial-banking?oga=true",
